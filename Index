        function nextKitId(){ const ids = store.kits.map(k=>k.id); return (ids.length? Math.max(...ids):100)+1; }
        function editKit(id){
            const k = (id!=null) ? store.kits.find(x=>x.id===id)
                                 : { title:'', desc:'', type:'Drum Kit', price:40, image:'', ornament:null, ornamentClass:'' };
            const html = fld('Title','kf-title',k.title) + fld('Description (короткая)','kf-desc',k.desc) +
                fld('Authors / авторы','kf-authors',k.authors||'','text','EmerBeats, KR2N') +
                fld('Type','kf-type',k.type,'text','Drum Kit / Bundle') +
                fld('Price $','kf-price',k.price,'number') +
                chkField('Free kit — бесплатный (вместо цены)','kf-free',!!k.free,'toggleFreeUrl()') +
                `<div id="kf-freeurl-wrap" style="${k.free?'':'display:none'}">` +
                    fld('Ссылка на скачивание (Google Drive / ТГ-пост / любой URL)','kf-freeurl',k.freeUrl||'','text','https://drive.google.com/...') +
                    `<p class="text-[10px] text-zinc-600 uppercase mt-1 leading-relaxed">Куда ведёт кнопка Download у бесплатного кита. Открывается в новой вкладке.</p>` +
                `</div>` +
                fld('Код для бота (необязательно)','kf-code',k.code||'','text', id!=null?('по умолчанию '+kitCode(k)):'напр. KIT-1') +
                imgField('Cover image','kf-image',k.image) +
                taField('INSIDE — содержимое, по одному пункту на строку','kf-contents',k.contents||'',8,'BASS 101\nKICK 50\nCLAPS 52') +
                `<p class="text-[10px] text-zinc-600 uppercase leading-relaxed">Каждая строка = один пункт списка INSIDE (напр. «KICK 50»). Показывается на карточке кита в раскрывающемся списке.</p>`;
            openAdminForm(id!=null?'Edit kit':'New kit', html, ()=>{
                const t = document.getElementById('kf-title').value.trim();
                if(!t){ alert('Введите название'); return; }
                const data = { title:t, desc:document.getElementById('kf-desc').value.trim(),
                    authors:document.getElementById('kf-authors').value.trim(),
                    type:document.getElementById('kf-type').value.trim()||'Kit',
                    price:+document.getElementById('kf-price').value||0,
                    free:document.getElementById('kf-free').checked,
                    freeUrl:document.getElementById('kf-freeurl').value.trim(),
                    code:document.getElementById('kf-code').value.trim(),
                    image:document.getElementById('kf-image').value.trim(),
                    contents:document.getElementById('kf-contents').value.replace(/\r/g,'').trim() };
                if(id!=null){ Object.assign(k, data); }
                else { store.kits.push({ id:nextKitId(), ornament:null, ornamentClass:'', ...data }); }
                saveData(); closeAdminForm(); renderAdmin(); refreshStorefront();
            });
        }
        function delKit(id){
            if(!confirm('Удалить кит?')) return;
            store.kits = store.kits.filter(k=>k.id!==id);
            saveData(); renderAdmin(); refreshStorefront();
        }

        function renderAdminSettings(){
            document.getElementById('admin-settings').innerHTML = `
                <h3 class="text-white uppercase tracking-widest text-sm mb-4 mt-10">Publish to website</h3>
                <div class="border-2 border-white p-4 mb-8 bg-zinc-950">
                    <p class="text-[11px] uppercase text-zinc-400 tracking-widest leading-relaxed mb-4">
                        Правки сохраняются у тебя в браузере. Чтобы они появились на сайте — жми кнопку ниже, получишь файл <span class="text-white">data.js</span> и положи его в папку рядом с сайтом (замени старый). Всё, каталог на сайте обновлён.
                    </p>
                    <button onclick="exportSiteData()" class="bg-white text-black px-6 py-3 text-xs uppercase font-bold hover:bg-zinc-300 transition-colors flex items-center gap-2">
                        <i data-lucide="download" class="w-4 h-4"></i> Save data.js for website
                    </button>
                </div>

                <h3 class="text-white uppercase tracking-widest text-sm mb-4 mt-10">Settings</h3>
                <div class="border border-white/20 p-4 flex flex-col gap-4 mb-6">
                    <label class="flex flex-col gap-1"><span class="text-[10px] uppercase tracking-widest text-zinc-500">Telegram link</span>
                        <input id="set-tg" value="${esc(store.tgLink)}" class="bg-transparent border border-white/30 px-3 py-2 text-white text-sm outline-none focus:border-white"/></label>
                    <label class="flex flex-col gap-1"><span class="text-[10px] uppercase tracking-widest text-zinc-500">Admin PIN</span>
                        <input id="set-pin" value="${esc(store.adminPin||'1234')}" class="bg-transparent border border-white/30 px-3 py-2 text-white text-sm outline-none focus:border-white w-32"/></label>
                    <button onclick="saveSettings()" class="bg-white text-black px-5 py-2 text-xs uppercase font-bold hover:bg-zinc-300 transition-colors self-start">Save settings</button>
