        /* ============ WEB AUDIO SYNTH PREVIEW ============ */
        // Generates a looping trap-style preview per beat (no audio files needed).
        let audioCtx = null, busGain = null, shaper = null, masterGain = null;
        let schedulerTimer = null, currentStep = 0, nextNoteTime = 0, playedSteps = 0;
        const LOOP_STEPS = 32; // 2 bars for the progress bar
        let muted = false, lastVolume = 0.7;

        // Playback engine: 'synth' (default) or 'audio' (when a beat has a real mp3)
        let engine = 'synth';
        const audioEl = document.getElementById('audio-el');
        audioEl.addEventListener('timeupdate', () => { if (engine==='audio') updateProgressUI(); });
        audioEl.addEventListener('ended', () => { if (engine==='audio'){ isPlaying=false; updatePlayIcons(); renderAlbumBeats(); } });

        const KEY_FREQ = {'C':32.70,'C#':34.65,'D':36.71,'D#':38.89,'E':41.20,'F':43.65,'F#':46.25,'G':49.00,'G#':51.91,'A':55.00,'A#':58.27,'B':61.74};
        function rootFreq(keyStr){
            const note = (keyStr||'A').split(' ')[0].toUpperCase();
            return (KEY_FREQ[note] || 55) * 2; // bring up an octave for audible bass
        }
        function seeded(seed){ const x = Math.sin(seed) * 10000; return x - Math.floor(x); }

        function makeDistortionCurve(amount){
            const n = 44100, curve = new Float32Array(n), deg = Math.PI/180;
            for (let i=0;i<n;i++){ const x = i*2/n - 1; curve[i] = (3+amount)*x*20*deg / (Math.PI + amount*Math.abs(x)); }
            return curve;
        }

        function initAudio(){
            if (audioCtx) return;
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            masterGain = audioCtx.createGain();
            masterGain.gain.value = muted ? 0 : lastVolume;
            shaper = audioCtx.createWaveShaper();
            shaper.curve = makeDistortionCurve(6);
            busGain = audioCtx.createGain();
            busGain.gain.value = 0.6;
            busGain.connect(shaper).connect(masterGain).connect(audioCtx.destination);
        }

        function kick(t){
            const o=audioCtx.createOscillator(), g=audioCtx.createGain();
            o.frequency.setValueAtTime(160,t); o.frequency.exponentialRampToValueAtTime(42,t+0.14);
            g.gain.setValueAtTime(1,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.32);
            o.connect(g).connect(busGain); o.start(t); o.stop(t+0.34);
        }
        function hat(t, open){
            const dur = open?0.28:0.045, n=audioCtx.sampleRate*dur;
            const b=audioCtx.createBuffer(1,n,audioCtx.sampleRate), d=b.getChannelData(0);
            for(let i=0;i<n;i++) d[i]=Math.random()*2-1;
            const s=audioCtx.createBufferSource(); s.buffer=b;
            const hp=audioCtx.createBiquadFilter(); hp.type='highpass'; hp.frequency.value=7500;
            const g=audioCtx.createGain(); g.gain.setValueAtTime(0.25,t); g.gain.exponentialRampToValueAtTime(0.001,t+dur);
            s.connect(hp).connect(g).connect(busGain); s.start(t); s.stop(t+dur);
        }
        function snare(t){
            const n=audioCtx.sampleRate*0.2, b=audioCtx.createBuffer(1,n,audioCtx.sampleRate), d=b.getChannelData(0);
            for(let i=0;i<n;i++) d[i]=Math.random()*2-1;
            const s=audioCtx.createBufferSource(); s.buffer=b;
            const bp=audioCtx.createBiquadFilter(); bp.type='bandpass'; bp.frequency.value=1900; bp.Q.value=0.7;
            const g=audioCtx.createGain(); g.gain.setValueAtTime(0.5,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.2);
            s.connect(bp).connect(g).connect(busGain); s.start(t); s.stop(t+0.2);
        }
        function bass(t, freq, dur){
            const o=audioCtx.createOscillator(); o.type='sawtooth'; o.frequency.value=freq;
            const lp=audioCtx.createBiquadFilter(); lp.type='lowpass'; lp.frequency.setValueAtTime(600,t); lp.frequency.exponentialRampToValueAtTime(180,t+dur);
            const g=audioCtx.createGain(); g.gain.setValueAtTime(0.0001,t); g.gain.linearRampToValueAtTime(0.5,t+0.02); g.gain.exponentialRampToValueAtTime(0.001,t+dur);
            o.connect(lp).connect(g).connect(busGain); o.start(t); o.stop(t+dur);
        }
        function lead(t, freq, dur){
            const o=audioCtx.createOscillator(); o.type='square'; o.frequency.value=freq;
            const g=audioCtx.createGain(); g.gain.setValueAtTime(0.0001,t); g.gain.linearRampToValueAtTime(0.12,t+0.01); g.gain.exponentialRampToValueAtTime(0.001,t+dur);
            o.connect(g).connect(busGain); o.start(t); o.stop(t+dur);
        }

        function scheduleStep(step, time){
            if(!currentTrack) return;
            const id = currentTrack.id, root = rootFreq(currentTrack.key);
            const bar = Math.floor(playedSteps / 16) % 2;
            // Kick pattern (16th grid within a bar)
            const kicks = [0,3,7,8,11]; // syncopated trap kick
            if (kicks.includes(step % 16) || (step%16===14 && seeded(id+bar)>0.5)) kick(time);
            // Snare / clap on the backbeat
            if (step % 16 === 4 || step % 16 === 12) snare(time);
            // Hi-hats: every step, with rolls seeded per track
            const roll = seeded(id*7 + step) > (0.78 - id*0.02);
            hat(time, step % 8 === 6);
            if (roll){ hat(time + (60/currentTrack.bpm)/8, false); }
            // Bass line — root / minor third / fifth
            const minorScale = [1, 1.1892, 1.4983]; // root, m3, 5th ratios
            if (step % 16 === 0) bass(time, root, 0.5);
            if (step % 16 === 6) bass(time, root * (bar? 1.4983 : 1.1892), 0.4);
            if (step % 16 === 10) bass(time, root * 1.4983, 0.35);
            // Sparse lead stabs for eerie top
            if (step % 8 === 0 && seeded(id + step) > 0.5) lead(time, root * 4 * minorScale[step%3], 0.25);
        }

        function scheduler(){
            const secPerStep = (60 / currentTrack.bpm) / 4;
            while (nextNoteTime < audioCtx.currentTime + 0.12){
                scheduleStep(currentStep, nextNoteTime);
                playedSteps++;
                updateProgressUI();
                nextNoteTime += secPerStep;
                currentStep = (currentStep + 1) % 16;
            }
            schedulerTimer = setTimeout(scheduler, 25);
        }

        function startEngine(){
            if (audioCtx.state === 'suspended') audioCtx.resume();
            nextNoteTime = audioCtx.currentTime + 0.05;
            clearTimeout(schedulerTimer);
            scheduler();
        }
        function stopEngine(){ clearTimeout(schedulerTimer); }

        function updateProgressUI(){
            const frac = (engine==='audio' && audioEl.duration)
                ? (audioEl.currentTime / audioEl.duration)
                : (playedSteps % LOOP_STEPS) / LOOP_STEPS;
            document.getElementById('player-progress').style.width = (frac*100) + '%';
            if (engine==='audio' && 'mediaSession' in navigator && audioEl.duration && isFinite(audioEl.duration)){
                try { navigator.mediaSession.setPositionState({ duration: audioEl.duration, position: audioEl.currentTime, playbackRate: audioEl.playbackRate || 1 }); } catch(e){}
            }
            if (currentTrack){
                const wf = document.querySelector(`#wf-${currentTrack.id}`);
                if (wf){
                    const bars = wf.querySelectorAll('.wf-bar');
                    const upTo = Math.floor(frac * bars.length);
                    bars.forEach((b,i)=> b.classList.toggle('played', i <= upTo));
                }
            }
        }

        /* ============ RENDER: BEATS ============ */
        function waveformBars(id){
            let s = '';
            for (let i=0;i<48;i++){ const h = 15 + Math.floor(seeded(id*100 + i)*85); s += `<span class="wf-bar" style="height:${h}%"></span>`; }
            return s;
        }

        function activeTags(){
            return Array.from(document.querySelectorAll('#tag-filters .tag-active')).map(el=>el.dataset.tag);
        }

        function renderTagFilters(){
            const all = [...new Set(allBeats.flatMap(b=>b.tags))].sort();
            const c = document.getElementById('tag-filters');
            c.innerHTML = all.map(t=>`<button data-tag="${t}" onclick="toggleTag(this)" class="px-3 py-1 border border-zinc-700 text-zinc-500 hover:border-white hover:text-white transition-colors tracking-widest">${t}</button>`).join('');
        }
        function toggleTag(btn){
            btn.classList.toggle('tag-active');
            btn.classList.toggle('bg-white'); btn.classList.toggle('text-black'); btn.classList.toggle('border-white');
            renderAlbums();
        }

        // Does an album match the current search + tag filters?
        function albumMatches(album, q, tags){
            const matchQ = !q || album.title.toLowerCase().includes(q) ||
                album.beats.some(b=>`${b.title} ${b.bpm} ${b.key} ${b.tags.join(' ')}`.toLowerCase().includes(q));
            const matchT = !tags.length || album.beats.some(b=>tags.every(t=>b.tags.includes(t)));
            return matchQ && matchT;
        }

