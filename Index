        // Downscale + compress an uploaded image before embedding, so localStorage stays small
        function uploadImageTo(inputId, fileInput){
            const f = fileInput.files[0]; if(!f) return;
            const r = new FileReader();
            r.onload = e => {
                const img = new Image();
                img.onload = () => {
                    const MAX = 700;
                    let w = img.width, h = img.height;
                    if (Math.max(w,h) > MAX){ const k = MAX/Math.max(w,h); w = Math.round(w*k); h = Math.round(h*k); }
                    const cv = document.createElement('canvas'); cv.width = w; cv.height = h;
                    cv.getContext('2d').drawImage(img, 0, 0, w, h);
                    let out; try { out = cv.toDataURL('image/jpeg', 0.82); } catch(err){ out = e.target.result; }
                    const field = document.getElementById(inputId);
                    if (field){ field.value = out; updateImgPreview(inputId, out); }
                };
                img.onerror = () => { const field = document.getElementById(inputId); if(field){ field.value = e.target.result; updateImgPreview(inputId, e.target.result); } };
                img.src = e.target.result;
            };
            r.readAsDataURL(f);
            fileInput.value = '';
        }
