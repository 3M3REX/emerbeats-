                <h4 class="text-zinc-400 uppercase tracking-widest text-[11px] mb-3">License prices (based on each beat's price)</h4>
                <div class="border border-white/20 p-4 flex flex-col gap-3 mb-6">
                    ${store.licenses.map((l,i)=>`
                        <div class="flex items-center gap-3 text-xs">
                            <span class="text-white uppercase w-28 shrink-0">${esc(l.name)}</span>
                            <span class="text-zinc-500 text-[10px] w-24 shrink-0">${l.mult!=null?'× multiplier':'+ add $'}</span>
                            <input id="lic-${i}" type="number" step="0.01" value="${l.mult!=null?l.mult:l.add}" class="bg-transparent border border-white/30 px-3 py-2 text-white w-28 outline-none focus:border-white"/>
                        </div>`).join('')}
                    <button onclick="saveLicenses()" class="bg-white text-black px-5 py-2 text-xs uppercase font-bold hover:bg-zinc-300 transition-colors self-start mt-2">Save prices</button>
                </div>

                <div class="border border-white/20 p-4 flex flex-wrap gap-2 mb-24 items-center">
                    <button onclick="exportData()" class="border border-white px-4 py-2 text-xs uppercase text-white hover:bg-white hover:text-black transition-colors">↓ Export backup</button>
                    <label class="border border-white px-4 py-2 text-xs uppercase text-white hover:bg-white hover:text-black transition-colors cursor-pointer">↑ Import backup<input type="file" accept="application/json,.json" class="hidden" onchange="importData(this)"/></label>
                    <button onclick="resetData()" class="border border-red-500/60 px-4 py-2 text-xs uppercase text-red-400 hover:bg-red-500 hover:text-white transition-colors ml-auto">Reset to defaults</button>
                </div>`;
        }
        function saveSettings(){
            store.tgLink = document.getElementById('set-tg').value.trim() || 'https://t.me/EmerBeatsBot';
            store.adminPin = document.getElementById('set-pin').value.trim() || '1234';
            saveData(); refreshStorefront(); showToast('Settings saved');
        }
        function saveLicenses(){
            store.licenses.forEach((l,i)=>{ const v=+document.getElementById('lic-'+i).value||0; if(l.mult!=null) l.mult=v; else l.add=v; });
            saveData(); refreshStorefront(); showToast('Prices saved');
        }
        function exportData(){
            const blob = new Blob([JSON.stringify(store,null,2)], {type:'application/json'});
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob); a.download = 'emerbeats-data.json'; a.click();
            setTimeout(()=>URL.revokeObjectURL(a.href), 1000);
        }
        // Publish: writes the catalog into data.js — drop it next to the site to update the live catalog
        function exportSiteData(){
            const js = "// EmerBeats catalog — generated by the admin panel. Keep this file next to emerbeats.html.\n"
                     + "window.STORE_DATA = " + JSON.stringify(store, null, 2) + ";\n";
            const blob = new Blob([js], {type:'application/javascript'});
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob); a.download = 'data.js'; a.click();
            setTimeout(()=>URL.revokeObjectURL(a.href), 1000);
            showToast('data.js готов — положи его в папку сайта');
        }
        function importData(input){
            const f = input.files[0]; if(!f) return;
            const r = new FileReader();
            r.onload = e => { try {
                const d = JSON.parse(e.target.result);
                if(!Array.isArray(d.albums)) throw 0;
                store = d; saveData(); renderAdmin(); refreshStorefront(); showToast('Backup imported');
            } catch(err){ alert('Неверный файл бэкапа'); } };
            r.readAsText(f);
            input.value = '';
        }
        function resetData(){
            if(!confirm('Сбросить каталог к стандартному? Все твои изменения удалятся.')) return;
            store = JSON.parse(JSON.stringify(DEFAULT_DATA));
            saveData(); renderAdmin(); refreshStorefront(); showToast('Reset to defaults');
        }

        /* ============ INIT ============ */
        // Apply the Telegram link to every .tg-link element
        document.querySelectorAll('.tg-link').forEach(a => a.href = TG_LINK);

        renderTagFilters();
        renderAlbums();
        renderKits();
        renderFAQ();
        renderLicenseGrid();
        updateCartUI();
        setupMediaSession();
        lucide.createIcons();

        // Admin is local-only: reveal the "Manage catalog" button just on your machine
        if (isLocalEnv()){
            document.getElementById('admin-trigger').classList.remove('hidden-tab');
            if (location.hash === '#admin') openAdmin();
            window.addEventListener('hashchange', ()=>{ if(location.hash === '#admin') openAdmin(); });
        }

        /* ============ CUSTOM CURSOR — gothic cross, inverted & tilted left ============ */
        (function setCrossCursor(){
            // Thin barbed gothic cross, centred on origin.
            // scale(1 -1) flips it (inverted), rotate(-22) tilts it to the LEFT.
            // Hotspot (13 6) sits on the leading tip so you click with the cross's end.
            const path = "M0,-62 L12,-46 L5,-40 L5,-19 L26,-19 L34,-24 L44,-14 L34,-4 L26,-9 L5,-9 "
                       + "L5,40 L12,46 L0,62 L-12,46 L-5,40 L-5,-9 L-26,-9 L-34,-4 L-44,-14 L-34,-24 "
                       + "L-26,-19 L-5,-19 L-5,-40 L-12,-46 Z";
            const svg = "<svg xmlns='http://www.w3.org/2000/svg' width='40' height='46' viewBox='-70 -80 140 160'>"
                + "<g transform='rotate(-22) scale(1 -1)' fill='#ffffff' stroke='#000000' stroke-width='3.5' stroke-linejoin='round'>"
                + "<path d='" + path + "'/></g></svg>";
            const cur = `url("data:image/svg+xml,${encodeURIComponent(svg)}") 13 6, auto`;
            const st = document.createElement('style');
            st.textContent = `* { cursor: ${cur} !important; } input, textarea, [contenteditable] { cursor: text !important; }`;
            document.head.appendChild(st);
        })();

        /* ============ PARTICLES — drifting ash ============ */
        (function particles(){
            const c = document.getElementById('particles');
            if (!c || !c.getContext) return;
            const ctx = c.getContext('2d');
            let w = 0, h = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);
            function mk(init){
                return {
                    x: Math.random() * w,
                    y: init ? Math.random() * h : -10,
                    r: (Math.random() * 1.6 + 0.4) * dpr,
                    s: (Math.random() * 0.35 + 0.08) * dpr,
                    drift: (Math.random() - 0.5) * 0.25 * dpr,
                    a: Math.random() * 0.4 + 0.08,
                    sway: Math.random() * Math.PI * 2
                };
            }
            let ps = [];
            function resize(){
                const nw = Math.floor(innerWidth * dpr), nh = Math.floor(innerHeight * dpr);
                if (nw === w && nh === h) return;
                const wasEmpty = (w === 0);
                w = c.width = nw; h = c.height = nh;
                c.style.width = innerWidth + 'px'; c.style.height = innerHeight + 'px';
                if (wasEmpty && w > 0){                       // first real size → seed
                    const N = Math.max(30, Math.min(90, Math.floor(innerWidth / 16)));
                    ps = Array.from({length: N}, () => mk(true));
                }
            }
            resize(); window.addEventListener('resize', resize);
            function tick(){
                resize();                                     // auto-fit when pane becomes visible
                ctx.clearRect(0, 0, w, h);
                for (const p of ps){
                    p.y += p.s; p.sway += 0.01; p.x += p.drift + Math.sin(p.sway) * 0.3 * dpr;
                    if (p.y > h + 12){ Object.assign(p, mk(false)); p.x = Math.random() * w; }
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, 6.2832);
                    ctx.fillStyle = `rgba(255,255,255,${p.a})`;
                    ctx.fill();
                }
                requestAnimationFrame(tick);
            }
            tick();
        })();

        /* ============ CURSOR GLOW — soft white light follows the pointer ============ */
        (function cursorGlow(){
            const g = document.getElementById('cursor-glow');
            if (!g) return;
            let x = innerWidth/2, y = innerHeight/2, tx = x, ty = y, shown = false, raf = 0;
            function loop(){
                x += (tx - x) * 0.18; y += (ty - y) * 0.18;   // smooth trailing
                g.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
                raf = requestAnimationFrame(loop);
            }
            window.addEventListener('mousemove', (e)=>{
                tx = e.clientX; ty = e.clientY;
                if (!shown){ shown = true; g.style.opacity = '1'; if(!raf) loop(); }
            }, { passive: true });
            window.addEventListener('mouseleave', ()=>{ g.style.opacity = '0'; });
            window.addEventListener('mousedown', ()=>{ g.style.opacity = '0.55'; });
            window.addEventListener('mouseup',   ()=>{ g.style.opacity = shown ? '1' : '0'; });
        })();

        /* ============ SCROLL REVEAL — fade blocks in as they enter view ============ */
        function revealIn(root){ (root||document).querySelectorAll('.reveal').forEach(el=>el.classList.add('revealed')); }
        (function initReveals(){
            const els = document.querySelectorAll('.reveal');
            if (!('IntersectionObserver' in window)){ els.forEach(e=>e.classList.add('revealed')); return; }
            const io = new IntersectionObserver((entries)=>{
                entries.forEach(en=>{ if(en.isIntersecting){ en.target.classList.add('revealed'); io.unobserve(en.target); } });
            }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
            els.forEach(e=>io.observe(e));
        })();
    </script>
