        /* ============ PLAYER ============ */
        function visibleBeatIds(){ return Array.from(document.querySelectorAll('.beat-row')).map(r=>+r.id.replace('beat-row-','')); }

        function playTrack(id){
            const track = allBeats.find(b=>b.id===id);
            if(!track) return;
            document.getElementById('global-player').classList.remove('translate-y-full');

            if (currentTrack?.id === id){ toggleGlobalPlay(); return; }

            // stop whatever is currently playing
            stopEngine();
            audioEl.pause();

            currentTrack = track;
            isPlaying = true;
            playedSteps = 0; currentStep = 0;
            document.getElementById('player-title').innerText = track.title;

            if ('mediaSession' in navigator){
                try { navigator.mediaSession.metadata = new MediaMetadata({ title: track.title, artist: 'EmerBeats', album: (currentAlbum && currentAlbum.title) || 'EmerBeats' }); } catch(e){}
                navigator.mediaSession.playbackState = 'playing';
            }

            if (track.audio){
                // Real mp3 preview
                engine = 'audio';
                audioEl.src = mediaUrl(track.audio, 'beats');
                audioEl.volume = muted ? 0 : lastVolume;
                audioEl.currentTime = 0;
                audioEl.play().catch(()=>{});
                document.getElementById('player-bpm').innerText = `${track.bpm} BPM · ${track.key}`;
            } else {
                // Synth preview
                engine = 'synth';
                initAudio();
                startEngine();
                document.getElementById('player-bpm').innerText = `${track.bpm} BPM · ${track.key} · SYNTH PREVIEW`;
            }
            updatePlayIcons();
            renderAlbumBeats();
        }
        function toggleGlobalPlay(){
            if(!currentTrack){ return; }
            isPlaying = !isPlaying;
            if (engine === 'audio'){
                if (isPlaying) audioEl.play().catch(()=>{}); else audioEl.pause();
            } else {
                initAudio();
                if (isPlaying){ audioCtx.resume(); startEngine(); }
                else stopEngine();
            }
            if ('mediaSession' in navigator) navigator.mediaSession.playbackState = isPlaying ? 'playing' : 'paused';
            updatePlayIcons();
            renderAlbumBeats();
        }
        function nextTrack(){
            const ids = visibleBeatIds(); if(!ids.length) return;
            const i = currentTrack ? ids.indexOf(currentTrack.id) : -1;
            playTrack(ids[(i+1) % ids.length]);
        }
        function prevTrack(){
            const ids = visibleBeatIds(); if(!ids.length) return;
            const i = currentTrack ? ids.indexOf(currentTrack.id) : 0;
            playTrack(ids[(i-1+ids.length) % ids.length]);
        }
        function seekTrack(id, e){
            if (currentTrack?.id !== id) { playTrack(id); return; }
            const wf = document.getElementById(`wf-${id}`);
            const rect = wf.getBoundingClientRect();
            const frac = Math.min(0.999, Math.max(0, (e.clientX - rect.left)/rect.width));
            if (engine === 'audio' && audioEl.duration){ audioEl.currentTime = frac * audioEl.duration; }
            else { playedSteps = Math.floor(frac * LOOP_STEPS); }
            updateProgressUI();
        }
        // Seek from the bottom player bar
        function seekPlayer(e){
            if(!currentTrack) return;
            const bar = document.getElementById('player-seek');
            const rect = bar.getBoundingClientRect();
            const frac = Math.min(0.999, Math.max(0, (e.clientX - rect.left)/rect.width));
            if (engine === 'audio' && audioEl.duration){ audioEl.currentTime = frac * audioEl.duration; }
            else { playedSteps = Math.floor(frac * LOOP_STEPS); }
            updateProgressUI();
        }
        // Wire the OS media controls (play/pause/next/prev/seek) to the player
        function setupMediaSession(){
            if(!('mediaSession' in navigator)) return;
            const h = (name, fn) => { try { navigator.mediaSession.setActionHandler(name, fn); } catch(e){} };
            h('play',  ()=>{ if(!isPlaying) toggleGlobalPlay(); });
            h('pause', ()=>{ if(isPlaying) toggleGlobalPlay(); });
            h('previoustrack', prevTrack);
            h('nexttrack', nextTrack);
            h('seekto', (d)=>{ if(engine==='audio' && audioEl.duration && d.seekTime!=null){ audioEl.currentTime = d.seekTime; updateProgressUI(); } });
            h('seekbackward', (d)=>{ if(engine==='audio') audioEl.currentTime = Math.max(0, audioEl.currentTime - (d.seekOffset||10)); });
            h('seekforward',  (d)=>{ if(engine==='audio') audioEl.currentTime = Math.min(audioEl.duration||0, audioEl.currentTime + (d.seekOffset||10)); });
        }
        function updatePlayIcons(){
            const c = document.getElementById('player-play-icon').parentNode;
            c.innerHTML = isPlaying
                ? '<i id="player-play-icon" data-lucide="pause" class="w-6 h-6 fill-current"></i>'
                : '<i id="player-play-icon" data-lucide="play" class="w-6 h-6 fill-current ml-1"></i>';
