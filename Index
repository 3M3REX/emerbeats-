                    <button onclick="editKit()" class="bg-white text-black px-4 py-2 text-xs uppercase font-bold hover:bg-zinc-300 transition-colors">+ Kit</button>
                </div>` +
                store.kits.map(k=>`
                <div class="flex items-center gap-3 p-3 border border-white/20 mb-2 text-xs">
                    <img src="${esc(mediaUrl(k.image,'image'))}" onerror="this.src='https://placehold.co/80/111/555?text=%3F'" class="w-10 h-10 object-cover border border-white/20 shrink-0"/>
                    <div class="flex-grow min-w-0"><div class="text-white uppercase truncate">${esc(k.title)}</div><div class="text-zinc-500 text-[10px] uppercase">${esc(k.type)}</div></div>
