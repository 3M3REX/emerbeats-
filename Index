    <style>
        .font-gothic { font-family: 'UnifrakturMaguntia', cursive; }
        .font-mono { font-family: 'Space Mono', monospace; }

        /* Heavy static noise overlay */
        .noise-layer {
            position: fixed; inset: 0; z-index: 9999; pointer-events: none; opacity: 0.15;
            background-image: url('data:image/svg+xml;utf8,%3Csvg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"%3E%3Cfilter id="noise"%3E%3CfeTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" stitchTiles="stitch"/%3E%3C/filter%3E%3Crect width="100%25" height="100%25" filter="url(%23noise)"/%3E%3C/svg%3E');
            mix-blend-mode: overlay;
        }

        /* Grungy Dirt & Scratches Layer */
        .dirt-layer {
            position: fixed; inset: 0; z-index: 9998; pointer-events: none; opacity: 0.35;
            background-image:
                url('data:image/svg+xml;utf8,%3Csvg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"%3E%3Cfilter id="dirt"%3E%3CfeTurbulence type="fractalNoise" baseFrequency="0.015" numOctaves="4" stitchTiles="stitch"/%3E%3C/filter%3E%3Crect width="100%25" height="100%25" filter="url(%23dirt)"/%3E%3C/svg%3E'),
                repeating-linear-gradient(63deg, transparent, transparent 150px, rgba(255,255,255,0.06) 150px, rgba(255,255,255,0.06) 151px),
                repeating-linear-gradient(-42deg, transparent, transparent 80px, rgba(0,0,0,0.8) 80px, rgba(0,0,0,0.8) 82px);
            mix-blend-mode: overlay;
        }

        /* Dark Vignette */
        .vignette {
            position: fixed; inset: 0; z-index: 9997; pointer-events: none;
            background: radial-gradient(circle at center, transparent 30%, rgba(0,0,0,0.95) 100%);
        }

        /* Scanlines */
        .scanlines::before {
            content: " "; display: block; position: absolute; top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
            z-index: 50; background-size: 100% 4px; pointer-events: none;
        }

        /* Smooth invert + glow on hover (replaces the jittery glitch) */
        .glitch-hover {
            position: relative;
            transition: background-color .25s ease, color .25s ease, letter-spacing .25s ease, box-shadow .25s ease;
        }
        .glitch-hover:hover {
            background-color: #ffffff;
            color: #000000;
            letter-spacing: 0.12em;
            box-shadow: 0 0 18px rgba(255,255,255,0.35);
        }
        .glitch-hover:active { transform: scale(0.97); }

        @keyframes spin { from { transform: rotate(0deg) } to { transform: rotate(360deg) } }

        @keyframes flicker {
            0%,100% { opacity: 1 }
            50% { opacity: 0.4 }
        }
        .flicker { animation: flicker 3s infinite; }

        /* Marquee */
        .marquee { overflow: hidden; white-space: nowrap; }
        .marquee > span { display: inline-block; padding-left: 100%; animation: marquee 22s linear infinite; }
        @keyframes marquee { 0% { transform: translateX(0) } 100% { transform: translateX(-100%) } }

        /* Sigilism / Y2K Ornaments */
        .sigil-ornament {
            position: absolute; pointer-events: none; z-index: 20;
            filter: invert(1) contrast(150%) brightness(150%); mix-blend-mode: screen;
        }

        body { background-color: #050505; color: #e5e5e5; overflow-x: hidden; }

        .invert-hover:hover img.cover-art { filter: invert(1) contrast(150%) grayscale(100%); }
        .hidden-tab { display: none !important; }

        /* Waveform */
        .wf { display: flex; align-items: center; gap: 2px; height: 40px; position: relative; cursor: pointer; }
        .wf-bar { flex: 1; min-width: 1px; background: #3f3f46; transition: background 0.15s; }
        .wf.is-active .wf-bar { background: #52525b; }
        .wf-bar.played { background: #ffffff; }
        /* Playing row is white — flip the waveform colours so progress stays visible */
        .wf.on-light .wf-bar { background: #bcbcc2; }
        .wf.on-light .wf-bar.played { background: #000000; }

        /* ===== PREMIUM ANIMATIONS ===== */
        /* Soft white glow that follows the cursor */
        #cursor-glow {
            position: fixed; top: 0; left: 0; width: 460px; height: 460px;
            z-index: 9995; pointer-events: none; opacity: 0;
            transform: translate(-50%, -50%);
            background: radial-gradient(circle, rgba(255,255,255,0.07) 0%, rgba(255,255,255,0.03) 35%, transparent 65%);
            mix-blend-mode: screen; transition: opacity .4s ease;
            will-change: transform;
        }

        /* Generic hover-zoom */
        .zoom-hover { transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease, border-color .35s ease; will-change: transform; }
        .zoom-hover:hover { transform: scale(1.04); }

        /* Product cards — lift + glow + brighten border on hover */
        .premium-card { transition: transform .4s cubic-bezier(.2,.8,.2,1), box-shadow .4s ease, border-color .4s ease; will-change: transform; }
        .premium-card:hover {
            transform: translateY(-8px) scale(1.012);
            border-color: rgba(255,255,255,0.65);
            box-shadow: 0 16px 50px rgba(0,0,0,.65), 0 0 34px rgba(255,255,255,.08);
        }

        /* Scroll-reveal */
        .reveal { opacity: 0; transform: translateY(26px); transition: opacity .8s ease, transform .8s cubic-bezier(.2,.8,.2,1); }
        .reveal.revealed { opacity: 1; transform: none; }

        /* Staggered card entrance */
        @keyframes cardIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
        .card-in { animation: cardIn .5s cubic-bezier(.2,.8,.2,1) both; }

        /* Smooth defaults for interactive bits */
        button, a, .beat-row, .lic-card { transition: transform .25s ease, background-color .25s ease, color .25s ease, box-shadow .25s ease; }
        .beat-row:hover { box-shadow: inset 3px 0 0 rgba(255,255,255,.9); }
        @media (prefers-reduced-motion: reduce) {
            .reveal { opacity: 1; transform: none; transition: none; }
            .card-in { animation: none; }
            .premium-card:hover, .zoom-hover:hover { transform: none; }
        }

        /* Scrollbar */
        #cart-items::-webkit-scrollbar { width: 4px; }
        #cart-items::-webkit-scrollbar-thumb { background: #fff; }

        /* Modal */
        .modal-back { background: rgba(0,0,0,0.85); backdrop-filter: blur(4px); }
        .lic-card { transition: all 0.15s; }
        .lic-card:hover, .lic-card.sel { background: #fff; color: #000; }
        .lic-card:hover .lic-mono, .lic-card.sel .lic-mono { color: #000; }
    </style>
</head>
